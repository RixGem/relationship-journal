{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relationship-journal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relationship-journal-db",
      "database_id": "6e7f1172-af3b-4a8f-9edb-3e9b9ca03b34",
      "migrations_dir": "./migrations"
    }
  ]
}
