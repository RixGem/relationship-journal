{
  "name": "relationship-journal",
  "version": "1.0.0",
  "description": "Cloudflare Workers + D1 relationship journal API with pre-LLM PII filtering, idempotent ingestion, and bitemporal signal tracking",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply relationship-journal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply relationship-journal-db --remote",
    "db:seed:local": "wrangler d1 execute relationship-journal-db --local -y --file=./sql/seed_test_demo.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
